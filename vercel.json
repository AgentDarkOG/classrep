{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/manage", "destination": "/api/manage" },
    { "source": "/manage.html", "destination": "/api/manage" }
  ],
  "functions": {
    "api/manage.mjs": {
      "includeFiles": "manage.html"
    },
    "api/listings.mjs": {}
  }
}
